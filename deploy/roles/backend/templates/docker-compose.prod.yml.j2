# Production docker-compose — generated by Ansible. Do not edit manually.

services:
  mysql:
    image: mysql:8.4
    container_name: glowbook-mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: "{{ vault_mysql_root_password }}"
      MYSQL_DATABASE: "{{ mysql_db }}"
      MYSQL_USER: "{{ mysql_user }}"
      MYSQL_PASSWORD: "{{ vault_mysql_password }}"
    # No external port — only accessible within the container network
    volumes:
      - glowbook_mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-p{{ vault_mysql_root_password }}"]
      interval: 10s
      timeout: 5s
      retries: 15
    networks:
      - glowbook

  api:
    build:
      context: .
      dockerfile: Dockerfile
    image: glowbook-api:latest
    container_name: glowbook-api
    restart: always
    environment:
      NODE_ENV: production
      PORT: "{{ backend_port }}"
      CORS_ORIGIN: "{{ frontend_url }},{{ frontend_url_www }}"
      DATABASE_URL: "mysql://{{ mysql_user }}:{{ vault_mysql_password }}@mysql:3306/{{ mysql_db }}"
      JWT_ACCESS_SECRET:  "{{ vault_jwt_access_secret }}"
      JWT_REFRESH_SECRET: "{{ vault_jwt_refresh_secret }}"
      JWT_ACCESS_TTL:  "15m"
      JWT_REFRESH_TTL: "30d"
      UPLOAD_DIR:    "/app/uploads"
      MAX_UPLOAD_MB: "5"
      RESEND_API_KEY: "{{ vault_resend_api_key }}"
      EMAIL_FROM:     "{{ email_from }}"
      APP_URL:        "{{ frontend_url }}"
      VAPID_PUBLIC_KEY:  "{{ vapid_public_key }}"
      VAPID_PRIVATE_KEY: "{{ vault_vapid_private_key }}"
      VAPID_SUBJECT:     "{{ vapid_subject }}"
      RECURRENTE_SECRET_KEY:     "{{ vault_recurrente_secret_key }}"
      RECURRENTE_SUBSCRIPTION_URL: "{{ recurrente_subscription_url }}"
      RECURRENTE_WEBHOOK_SECRET: "{{ vault_recurrente_webhook_secret | default('') }}"
    ports:
      # Only listen on localhost — Nginx proxies external traffic
      - "127.0.0.1:{{ backend_port }}:{{ backend_port }}"
    volumes:
      - glowbook_uploads:/app/uploads
    depends_on:
      mysql:
        condition: service_healthy
    networks:
      - glowbook

volumes:
  glowbook_mysql_data:
  glowbook_uploads:

networks:
  glowbook:
    driver: bridge
