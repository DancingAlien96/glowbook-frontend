# /etc/nginx/sites-available/ecodama.conf
# Managed by Ansible — do not edit manually.
# certbot will append SSL blocks below after first run.

server {
    listen 80;
    server_name {{ domain }} {{ www_domain }};

    client_max_body_size 20M;
    root /var/www/ecodama;

    # Express backend API
    location /api/ {
        proxy_pass         http://127.0.0.1:{{ backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Static uploads served by backend
    location /uploads/ {
        proxy_pass       http://127.0.0.1:{{ backend_port }};
        proxy_set_header Host $host;
    }

    # Static files (Next.js export output)
    location /_next/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Frontend files (try file, then index.html for SPA routing)
    location / {
        try_files $uri $uri/ /index.html;
        expires 1h;
        add_header Cache-Control "public";
    }
}
