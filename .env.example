# Backend API URL
# Required: API endpoint where the frontend makes requests to
# Example: https://api.ecodama.online or http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# UploadThing Token
# Required: Authentication token for file uploads (receipts, cover images, etc.)
# Get this from https://uploadthing.com — it's a secret key that authenticates
# your app's uploads. Used by the receiptUploader, coverUploader, and
# subscriptionReceiptUploader endpoints in app/api/uploadthing/core.ts
UPLOADTHING_TOKEN=your_uploadthing_token_here
